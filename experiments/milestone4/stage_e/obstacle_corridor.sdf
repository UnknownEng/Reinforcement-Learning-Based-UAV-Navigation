<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="obstacle_corridor">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane at z=0 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- STANDARDIZED CYLINDRICAL OBSTACLES: Radius = 0.30m, Height = 3.0m   -->
    <!-- All obstacles span z in [0.0, 3.0]m, centered vertically at z=1.5m -->
    <!-- =================================================================== -->

    <!-- Obstacle 1: Directly Ahead (Front Sector, 0 deg) at surface distance 3.00m (center D=3.30m) -->
    <model name="obs_ahead_3m">
      <static>true</static>
      <pose>3.4200 0.0000 1.5000 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: Sector Boundary (+22.5 deg) at surface distance 3.00m (center D=3.30m) -->
    <!-- Straddles boundary between Front [-22.5, +22.5) and Front-Left [+22.5, +67.5) -->
    <model name="obs_boundary_3m">
      <static>true</static>
      <pose>3.1688 1.2629 1.5000 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.9 0.6 0.1 1</ambient><diffuse>0.9 0.6 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3: Front-Left (+45.0 deg) at surface distance 2.50m (center D=2.80m) -->
    <model name="obs_front_left_2_5m">
      <static>true</static>
      <pose>2.0999 1.9799 1.5000 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 4: Left (+70.0 deg) Far Obstacle at surface distance 5.00m (center D=5.30m) -->
    <model name="obs_far_5m">
      <static>true</static>
      <pose>1.9327 4.9804 1.5000 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.9 1</ambient><diffuse>0.1 0.4 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 5: Front-Right (-35.0 deg) Close Obstacle at surface distance 1.50m (center D=1.80m) -->
    <model name="obs_close_1_5m">
      <static>true</static>
      <pose>1.5945 -1.0324 1.5000 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.8 1</ambient><diffuse>0.9 0.1 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 6: Front-Right (-55.0 deg) at surface distance 2.50m (center D=2.80m) -->
    <model name="obs_front_right_2_5m">
      <static>true</static>
      <pose>1.7260 -2.2936 1.5000 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.8 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Downward Test Platform: beneath origin at z=0.25m, height 0.50m (top at z=0.50m) -->
    <model name="downward_platform">
      <static>true</static>
      <pose>0.0 0.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.8 0.8 0.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.8 0.8 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
