<?xml version="1.0"?>
<model>
  <name>x500_lidar3d_cam</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>x500_lidar3d plus two recording-only cameras (onboard forward FPV and a third-person chase camera on a massless virtual boom), 640x360 at 10 Hz on /uav/camera/fpv and /uav/camera/chase. Used to make videos and figures; the navigation policy only uses the LiDAR.</description>
</model>
