# ArduPilot SITL 5-inch 6S Freestyle FPV Quadcopter Parameter Overrides
# Frame: 220mm True-X, AUW: 0.68 kg, Motors: 2207 1950KV on 6S LiPo, 5.1x4.6x3 props
# Calculated Thrust-to-Weight Ratio: ~9.8:1

# ----------------- System & Architecture -----------------
FRAME_CLASS         1       # Multicopter
FRAME_TYPE          1       # X-Quad
SCHED_LOOP_RATE     400     # 400 Hz fast inner control loop for FPV agility
ARMING_CHECK        0       # Disable pre-arm checks for headless automated RL resets
DISARM_DELAY        0       # Do not automatically disarm
FS_THR_ENABLE       0       # Disable throttle failsafe during simulation steps
FS_GCS_ENABLE       0       # Disable ground station disconnect failsafe
FS_CRASH_CHECK      0       # Handled directly by Gym environment
BATT_MONITOR        0       # Battery simulation off for continuous RL training steps

# ----------------- Motor & ESC Dynamics -----------------
MOT_PWM_TYPE        4       # DShot protocol (ultra-low latency digital ESC)
MOT_PWM_MIN         1000
MOT_PWM_MAX         2000
MOT_SPIN_ARM        0.08    # Idle spin rate
MOT_SPIN_MIN        0.12    # Minimum operational throttle
MOT_SPIN_MAX        0.98    # Headroom
MOT_THST_EXPO       0.55    # Non-linear thrust expo curve for 5-inch props
MOT_HOVER_LEARN     0       # Fixed hover learning
MOT_THST_HOVER      0.15    # Extremely low hover throttle (~15%) characteristic of 6S FPV

# ----------------- Attitude Controller Agility -----------------
# Maximum angular rates (deg/sec) and angular accelerations (deg/sec^2)
ATC_RATE_R_MAX      720.0   # 720 deg/s roll rate
ATC_RATE_P_MAX      720.0   # 720 deg/s pitch rate
ATC_RATE_Y_MAX      540.0   # 540 deg/s yaw rate
ATC_ACCEL_R_MAX     180000  # Rapid FPV rotational acceleration
ATC_ACCEL_P_MAX     180000
ATC_ACCEL_Y_MAX     72000

# Angle P Gains
ATC_ANG_RLL_P       12.0
ATC_ANG_PIT_P       12.0
ATC_ANG_YAW_P       8.0

# Rate PID Gains (Roll)
ATC_RAT_RLL_P       0.130
ATC_RAT_RLL_I       0.160
ATC_RAT_RLL_D       0.0036
ATC_RAT_RLL_FLTT    80.0
ATC_RAT_RLL_FLTD    40.0

# Rate PID Gains (Pitch)
ATC_RAT_PIT_P       0.140
ATC_RAT_PIT_I       0.170
ATC_RAT_PIT_D       0.0040
ATC_RAT_PIT_FLTT    80.0
ATC_RAT_PIT_FLTD    40.0

# Rate PID Gains (Yaw)
ATC_RAT_YAW_P       0.350
ATC_RAT_YAW_I       0.040
ATC_RAT_YAW_D       0.0000
ATC_RAT_YAW_FLTE    10.0

# ----------------- IMU & Filtering -----------------
INS_GYR_FILTER      80      # High gyro filter cutoff for responsive 400Hz loop
INS_ACC_FILTER      40      # Accelerometer filter cutoff
INS_FAST_SAMPLE     1       # Fast gyro sampling enabled

# ----------------- Navigation & Position Control -----------------
PSC_POSZ_P          1.0
PSC_VELZ_P          5.0
PSC_VELZ_I          2.0
PSC_VELZ_D          0.0
PSC_ACCZ_P          0.20
PSC_ACCZ_I          0.50
PSC_ACCZ_D          0.00
PSC_ACCZ_FLTE       20.0

# ----------------- MAVLink & Offboard -----------------
SERIAL0_BAUD        115     # USB console
SERIAL1_BAUD        921     # High-speed telemetry link to MAVROS
SR1_POSITION        50      # Stream position at 50 Hz
SR1_EXTRA1          50      # Stream attitude at 50 Hz
SR1_RAW_SENS        50      # Stream IMU at 50 Hz
