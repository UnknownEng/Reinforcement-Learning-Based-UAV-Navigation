<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="fpv_drone">
    <pose>0 0 0.1 0 0 0</pose>

    <!-- ==================== BASE AIRFRAME ==================== -->
    <link name="base_link">
      <inertial>
        <pose>0 0 0.015 0 0 0</pose>
        <mass>0.65</mass> <!-- AUW including 6S 1300mAh LiPo & OAK-D Lite -->
        <inertia>
          <ixx>0.0045</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0045</iyy>
          <iyz>0.0</iyz>
          <izz>0.0080</izz>
        </inertia>
      </inertial>

      <!-- Collision Mesh: Simplified primitive box to prevent clipping and physics stalls -->
      <collision name="base_collision">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry>
          <box>
            <size>0.22 0.22 0.06</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.002</min_depth>
              <max_vel>0.0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Visual Carbon Frame Representation -->
      <visual name="fuselage_visual">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.12 0.05 0.035</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
          <specular>0.4 0.4 0.4 1.0</specular>
          <pbr>
            <metal>
              <roughness>0.3</roughness>
              <metalness>0.8</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="arm_front_right">
        <pose>0.05 -0.05 0.005 0 0 -0.785398</pose>
        <geometry>
          <box><size>0.12 0.016 0.005</size></box>
        </geometry>
        <material><diffuse>0.1 0.1 0.1 1.0</diffuse></material>
      </visual>

      <visual name="arm_rear_left">
        <pose>-0.05 0.05 0.005 0 0 -0.785398</pose>
        <geometry>
          <box><size>0.12 0.016 0.005</size></box>
        </geometry>
        <material><diffuse>0.1 0.1 0.1 1.0</diffuse></material>
      </visual>

      <visual name="arm_front_left">
        <pose>0.05 0.05 0.005 0 0 0.785398</pose>
        <geometry>
          <box><size>0.12 0.016 0.005</size></box>
        </geometry>
        <material><diffuse>0.1 0.1 0.1 1.0</diffuse></material>
      </visual>

      <visual name="arm_rear_right">
        <pose>-0.05 -0.05 0.005 0 0 0.785398</pose>
        <geometry>
          <box><size>0.12 0.016 0.005</size></box>
        </geometry>
        <material><diffuse>0.1 0.1 0.1 1.0</diffuse></material>
      </visual>

      <!-- Battery Pack (6S LiPo) Visual -->
      <visual name="battery_visual">
        <pose>0 0 0.035 0 0 0</pose>
        <geometry>
          <box><size>0.075 0.038 0.032</size></box>
        </geometry>
        <material>
          <diffuse>0.8 0.1 0.1 1.0</diffuse>
        </material>
      </visual>

      <!-- ==================== LUXONIS OAK-D CAMERA ==================== -->
      <!-- Mounted with a 15-degree uptilt (0.2618 rad) standard for freestyle FPV forward flight -->
      <sensor name="oak_d_depth" type="depth_camera">
        <pose>0.08 0 0.025 0 0.2618 0</pose>
        <always_on>1</always_on>
        <!-- 20 Hz update rate drastically reduces rendering overhead on MX450 vGPU -->
        <update_rate>20</update_rate>
        <visualize>false</visualize>
        <topic>/oak_d/depth</topic>
        <camera>
          <horizontal_fov>1.39626</horizontal_fov> <!-- 80 degrees HFOV -->
          <image>
            <width>160</width>
            <height>120</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.15</near>
            <far>15.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.015</stddev>
          </noise>
        </camera>
      </sensor>

      <!-- IMU Sensor -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0.01 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>400</update_rate>
        <topic>/imu</topic>
      </sensor>
    </link>

    <!-- ==================== ROTOR 0 (Front-Right, CCW) ==================== -->
    <link name="rotor_0">
      <pose>0.078 -0.078 0.025 0 0 0</pose>
      <inertial>
        <mass>0.008</mass>
        <inertia>
          <ixx>9.75e-07</ixx><iyy>4.17e-05</iyy><izz>4.26e-05</izz>
        </inertia>
      </inertial>
      <collision name="rotor_0_collision">
        <geometry><cylinder><radius>0.0635</radius><length>0.006</length></cylinder></geometry>
      </collision>
      <visual name="rotor_0_visual">
        <geometry><cylinder><radius>0.0635</radius><length>0.006</length></cylinder></geometry>
        <material><diffuse>0.2 0.7 1.0 0.8</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>

    <!-- ==================== ROTOR 1 (Rear-Left, CCW) ==================== -->
    <link name="rotor_1">
      <pose>-0.078 0.078 0.025 0 0 0</pose>
      <inertial>
        <mass>0.008</mass>
        <inertia>
          <ixx>9.75e-07</ixx><iyy>4.17e-05</iyy><izz>4.26e-05</izz>
        </inertia>
      </inertial>
      <collision name="rotor_1_collision">
        <geometry><cylinder><radius>0.0635</radius><length>0.006</length></cylinder></geometry>
      </collision>
      <visual name="rotor_1_visual">
        <geometry><cylinder><radius>0.0635</radius><length>0.006</length></cylinder></geometry>
        <material><diffuse>0.2 0.7 1.0 0.8</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>

    <!-- ==================== ROTOR 2 (Front-Left, CW) ==================== -->
    <link name="rotor_2">
      <pose>0.078 0.078 0.025 0 0 0</pose>
      <inertial>
        <mass>0.008</mass>
        <inertia>
          <ixx>9.75e-07</ixx><iyy>4.17e-05</iyy><izz>4.26e-05</izz>
        </inertia>
      </inertial>
      <collision name="rotor_2_collision">
        <geometry><cylinder><radius>0.0635</radius><length>0.006</length></cylinder></geometry>
      </collision>
      <visual name="rotor_2_visual">
        <geometry><cylinder><radius>0.0635</radius><length>0.006</length></cylinder></geometry>
        <material><diffuse>1.0 0.3 0.2 0.8</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>

    <!-- ==================== ROTOR 3 (Rear-Right, CW) ==================== -->
    <link name="rotor_3">
      <pose>-0.078 -0.078 0.025 0 0 0</pose>
      <inertial>
        <mass>0.008</mass>
        <inertia>
          <ixx>9.75e-07</ixx><iyy>4.17e-05</iyy><izz>4.26e-05</izz>
        </inertia>
      </inertial>
      <collision name="rotor_3_collision">
        <geometry><cylinder><radius>0.0635</radius><length>0.006</length></cylinder></geometry>
      </collision>
      <visual name="rotor_3_visual">
        <geometry><cylinder><radius>0.0635</radius><length>0.006</length></cylinder></geometry>
        <material><diffuse>1.0 0.3 0.2 0.8</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>

    <!-- ==================== MOTOR DYNAMICS PLUGINS (5-inch 6S) ==================== -->
    <!-- Max thrust per motor = 16.5 N. Motor Constant km = 1.833e-06 N/(rad/s)^2 at max 3000 rad/s -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>3000.0</maxRotVelocity>
      <motorConstant>1.833e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <rotorDragCoefficient>8.06e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1.0e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorNumber>0</motorNumber>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>3000.0</maxRotVelocity>
      <motorConstant>1.833e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <rotorDragCoefficient>8.06e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1.0e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorNumber>1</motorNumber>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>3000.0</maxRotVelocity>
      <motorConstant>1.833e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <rotorDragCoefficient>8.06e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1.0e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorNumber>2</motorNumber>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>3000.0</maxRotVelocity>
      <motorConstant>1.833e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <rotorDragCoefficient>8.06e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1.0e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorNumber>3</motorNumber>
    </plugin>

    <!-- ==================== ARDUPILOT SITL GAZEBO PLUGIN ==================== -->
    <plugin filename="ArduPilotPlugin" name="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <fdm_port_out>9003</fdm_port_out>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <modelNamespace>fpv_drone</modelNamespace>
      <have_cv_bridge>0</have_cv_bridge>

      <imuName>imu_sensor</imuName>

      <!-- Motor 1 (FR CCW) -->
      <control channel="0">
        <jointName>rotor_0_joint</jointName>
        <useForce>1</useForce>
        <multiplier>3000.0</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
      </control>

      <!-- Motor 2 (RL CCW) -->
      <control channel="1">
        <jointName>rotor_1_joint</jointName>
        <useForce>1</useForce>
        <multiplier>3000.0</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
      </control>

      <!-- Motor 3 (FL CW) -->
      <control channel="2">
        <jointName>rotor_2_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-3000.0</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
      </control>

      <!-- Motor 4 (RR CW) -->
      <control channel="3">
        <jointName>rotor_3_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-3000.0</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
      </control>
    </plugin>
  </model>
</sdf>
